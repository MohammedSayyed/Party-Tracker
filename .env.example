# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER ONLY - never prefix with NEXT_PUBLIC_.
# Used by the order API route and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# The single party this deployment tracks.
NEXT_PUBLIC_PARTY_ID=TEAM-PARTY-2026-09-10

# Password for the hidden admin page at /hot-admin. SERVER ONLY - never prefix
# with NEXT_PUBLIC_. Admin actions are disabled entirely when this is unset.
ADMIN_PASSWORD=
